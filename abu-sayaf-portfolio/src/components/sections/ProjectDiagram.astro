---
import Icon from '../ui/Icon.astro';
interface Props { kind: 'commerce' | 'automation' }
const { kind } = Astro.props;
---
<div class="project-visual" data-project-diagram aria-label={kind === 'commerce' ? 'Interactive commerce system components' : 'Interactive event automation components'}>
  {kind === 'commerce' ? (
    <div class="system-diagram system-diagram--commerce">
      <button class="diagram-node" type="button" data-node-label="Storefronts" data-node-detail="Tenant-aware storefronts, authentication, catalog, and checkout." aria-pressed="false"><Icon name="store" size={20}/><span>Storefronts</span></button>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <div class="diagram-stack" aria-label="Commerce services">
        <button type="button" class="diagram-node" data-node-label="Orders" data-node-detail="Idempotent order handling and clear transaction boundaries." aria-pressed="false"><Icon name="shopping-cart" size={17}/> Orders</button>
        <button type="button" class="diagram-node" data-node-label="Inventory" data-node-detail="Stock state, reservations, and consistency across channels." aria-pressed="false"><Icon name="package" size={17}/> Inventory</button>
        <button type="button" class="diagram-node" data-node-label="Payments" data-node-detail="Payment integration and robust asynchronous confirmation." aria-pressed="false"><Icon name="credit-card" size={17}/> Payments</button>
      </div>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <button type="button" class="diagram-node" data-node-label="Data" data-node-detail="Structured persistence, caching, access control, and recovery." aria-pressed="false"><Icon name="database" size={20}/><span>Data</span></button>
    </div>
  ) : (
    <div class="system-diagram system-diagram--automation">
      <button type="button" class="diagram-node" data-node-label="Events" data-node-detail="A reliable trigger for new and updated orders." aria-pressed="false"><Icon name="bolt" size={19}/><span>Events</span></button>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <button type="button" class="diagram-node diagram-node--center" data-node-label="Workflows" data-node-detail="Event processing, retries, acknowledgments, and idempotency." aria-pressed="false"><Icon name="settings" size={20}/><span>Workflows</span></button>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <div class="diagram-stack">
        <button type="button" class="diagram-node" data-node-label="Alerts" data-node-detail="Timely notifications with acknowledgment states." aria-pressed="false"><Icon name="bell" size={17}/> Alerts</button>
        <button type="button" class="diagram-node" data-node-label="Visibility" data-node-detail="Monitor failures, event flow, and acknowledgment latency." aria-pressed="false"><Icon name="activity" size={17}/> Visibility</button>
      </div>
    </div>
  )}
  <p class="diagram-explanation" aria-live="polite">Select a component to explore its responsibility.</p>
</div>
