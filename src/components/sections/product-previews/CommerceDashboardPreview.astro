---
import Icon from './PreviewIcon.astro';

import ProductThumbnail from './ProductThumbnail.astro';

interface Props { showSecondOrder?: boolean }
const { showSecondOrder = false } = Astro.props;
const metrics = [
  ['shopping-cart', 'Total Orders', '248', 'violet'],
  ['trending-up', 'Collected', '৳246,800', 'green'],
  ['clock-3', 'Pending', '12', 'amber'],
];
const links = [
  ['layout-dashboard', 'Overview'], ['shopping-cart', 'Orders'], ['message-circle', 'Live Chat'], ['users', 'Customers'], ['megaphone', 'Marketing'], ['settings', 'Settings'],
];
const bestSellers = [
  { name: 'Premium Tee', variant: 'tee', units: 38 },
  { name: 'Canvas Tote', variant: 'tote', units: 26 },
  { name: 'Classic Polo', variant: 'polo', units: 18 },
] as const;
---
<div class="desk-preview" data-commerce-preview data-hero={showSecondOrder || undefined} aria-label="Commerce dashboard with sample data">
  <aside aria-hidden="true">
    <strong class="desk-preview-brand">
      <span class="desk-preview-mark"><Icon name="lucide:shopping-cart" aria-hidden="true" /></span>
      <span class="desk-preview-name">Commerce Desk</span>
    </strong>
    {links.map(([icon, text], index) => (
      <span class:list={['desk-preview-link', { 'desk-preview-current': index === 0 }]}><Icon name={`lucide:${icon}`} /><span><span>{text}</span></span></span>
    ))}
  </aside>
  <div class="desk-preview-main">
    <header class="desk-preview-toolbar">
      <strong><Icon name="lucide:menu" aria-hidden="true" /> <span>Dashboard</span></strong>
      <small><span>Last 30 days</span></small>
    </header>
    <div class="desk-preview-content">
      <dl class="desk-preview-metrics">
        {metrics.map(([icon, label, value, tone], index) => (
          <div class={`desk-preview-metric tone-${tone}`}>
            <dt><span><span>{label}</span></span><span class="desk-preview-metric-icon"><Icon name={`lucide:${icon}`} aria-hidden="true" /></span></dt>
            <dd>{index === 0 ? <><span class="desk-order-before"><span>{value}</span></span><span class="desk-order-after">249</span></> : <span>{value}</span>}</dd>
          </div>
        ))}
      </dl>
      <div class="desk-preview-reports">
        <section class="desk-preview-graph" aria-label="Order total over time">
          <strong><span>Sales over time</span></strong>
          <svg viewBox="0 0 320 100" preserveAspectRatio="none" role="img" aria-label="Sample daily order totals">
            <path class="desk-preview-area" d="M0 94 H50 Q76 94 91 75 T129 82 T178 66 T230 76 C256 76 267 14 281 14 S304 85 320 89 V100 H0 Z" />
            <path class="desk-preview-line" pathLength="1" d="M0 94 H50 Q76 94 91 75 T129 82 T178 66 T230 76 C256 76 267 14 281 14 S304 85 320 89" />
          </svg>
          <div class="desk-preview-dates" aria-hidden="true"><span><span>Nov 1</span></span><span><span>Nov 12</span></span><span><span>Nov 24</span></span></div>
        </section>
        <section class="desk-preview-sellers" aria-label="Top selling products">
          <strong><span>Top selling products</span></strong>
          <ul>
            {bestSellers.map(({ name, variant, units }) => (
              <li>
                <ProductThumbnail variant={variant} />
                <span class="desk-preview-product"><span>{name}</span><span class="desk-preview-track" aria-hidden="true"><i style={`--sales-width:${units / bestSellers[0].units * 100}%`}></i></span></span>
                <small>{units} sold</small>
              </li>
            ))}
          </ul>
        </section>
      </div>
      <section class="desk-preview-recent" aria-label="Recent orders">
        <strong><span>Recent orders</span></strong>
        <div>
          <span><span class="desk-order-before">#EC-1041</span><span class="desk-order-after">#EC-1042</span></span>
          <span class="desk-preview-recent-product"><ProductThumbnail /> <span>Premium Tee</span></span><span>৳1,290</span><small><span>Pending</span></small>
        </div>
        {showSecondOrder && (
          <div>
            <span>#EC-1040</span>
            <span class="desk-preview-recent-product"><ProductThumbnail variant="tote" /> <span>Canvas Tote</span></span>
            <span>৳990</span><small class="desk-preview-paid"><span>Paid</span></small>
          </div>
        )}
      </section>
    </div>
  </div>
</div>

<style>
  .desk-preview { container: commerce-preview / inline-size; display: grid; grid-template-columns: clamp(5.3rem, 24%, 8rem) minmax(0,1fr); min-width: 0; background: #f5f8fc; color: #17263a; font: 400 .68rem/1.3 system-ui, sans-serif; text-align: left; }
  .desk-preview aside { display: grid; align-content: start; min-width: 0; gap: .18rem; padding: .55rem .32rem; background: #152137; color: #f0f5ff; }
  .desk-preview-brand, .desk-preview-link, .desk-preview-toolbar strong, .desk-preview-metrics dt { display: flex; align-items: center; gap: .27rem; }
  .desk-preview-brand { min-width: 0; margin-bottom: .35rem; font-size: .72rem; font-weight: 750; line-height: 1.25; letter-spacing: -.015em; }
  .desk-preview-name { min-width: 0; text-wrap: balance; overflow-wrap: anywhere; }
  .desk-preview-mark { display: grid; place-items: center; flex: none; width: .78rem; height: .78rem; border-radius: 3px; background: #e7efff; color: #2458be; }
  .desk-preview-mark svg { width: .6rem; height: .6rem; }
  .desk-preview-link { min-width: 0; gap: .33rem; padding: .32rem .24rem; border-radius: 4px; color: #cdd9eb; font-size: .66rem; font-weight: 550; line-height: 1.2; }
  .desk-preview-link svg, .desk-preview-toolbar svg { width: .72rem; height: .72rem; flex: none; }
  .desk-preview-link > span { display: block; min-width: 0; overflow-wrap: anywhere; }
  .desk-preview-current { background: #2863cf; color: #fff; font-weight: 700; }
  .desk-preview-main { min-width: 0; }
  .desk-preview-toolbar { display: flex; align-items: center; justify-content: space-between; gap: .3rem; padding: .4rem .55rem; border-bottom: 1px solid #e0e8f3; background: #fff; }
  .desk-preview-toolbar strong { font-size: 1.2em; font-weight: 800; }
  .desk-preview-toolbar small { color: #4c5e77; white-space: nowrap; }
  .desk-preview-content, .desk-preview-metrics, .desk-preview-reports { display: grid; gap: .42rem; }
  .desk-preview-content { padding: .45rem; }
  .desk-preview-metrics { grid-template-columns: repeat(3,minmax(0,1fr)); gap: .28rem; margin: 0; }
  .desk-preview-metric, .desk-preview-reports > section, .desk-preview-recent { min-width: 0; padding: .34rem; border: 1px solid #e0e8f3; border-radius: 5px; background: #fff; box-shadow: 0 1px 2px #1826380c; }
  .desk-preview-metric { --metric-ink: #483ac5; --metric-tint: #eeedff; }
  .tone-green { --metric-ink: #087455; --metric-tint: #e7faf2; }
  .tone-amber { --metric-ink: #914812; --metric-tint: #fff1cc; border-inline-start: 2px solid #f39b24; }
  .desk-preview-metrics dt { flex-direction: row-reverse; justify-content: flex-end; color: #4b5362; line-height: 1.2; }
  .desk-preview-metric-icon { display: grid; place-items: center; flex: none; width: .95rem; height: .95rem; border-radius: 3px; color: var(--metric-ink); background: var(--metric-tint); }
  .desk-preview-metric-icon svg { width: .65rem; height: .65rem; }
  .desk-preview-metrics dd { margin: .18rem 0 0; color: var(--metric-ink); font-size: 1.25em; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .desk-preview-reports { grid-template-columns: minmax(0,1.05fr) minmax(0,1fr); }
  .desk-preview-graph svg { display: block; width: 100%; height: clamp(2.25rem,10cqw,4rem); margin-top: .25rem; background: repeating-linear-gradient(to top,#e8eff6 0 1px,transparent 1px 25%); }
  .desk-preview-area { fill: #0866ff; opacity: .15; }
  .desk-preview-line { fill: none; stroke: #0866ff; stroke-width: 2; vector-effect: non-scaling-stroke; stroke-dasharray: 1; animation: preview-draw .9s ease-out both; }
  .desk-preview-dates { display: flex; justify-content: space-between; color: #4d607a; font-size: .8em; }
  .desk-preview-sellers ul { display: grid; gap: .28rem; margin: 0; padding: .3rem 0 0; list-style: none; }
  .desk-preview-sellers li { display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: .28rem; margin: 0; font-size: .9em; }
  .desk-preview-sellers small { color: #526581; white-space: nowrap; }
  .desk-preview-track { display: block; height: 2px; margin-top: .2rem; border-radius: 3px; background: #e7eef7; }
  .desk-preview-track i { display: block; width: var(--sales-width); height: 100%; border-radius: inherit; background: #4a8bed; }
  .desk-preview-recent > div { display: grid; grid-template-columns: auto minmax(0,1fr) auto auto; align-items: center; gap: .35rem; margin-top: .23rem; padding-top: .2rem; border-top: 1px solid #edf0f3; font-variant-numeric: tabular-nums; }
  .desk-preview-recent > div > :nth-child(3) { white-space: nowrap; }
  .desk-preview-recent-product { display: flex; align-items: center; gap: .25rem; min-width: 0; }
  .desk-preview-recent small { padding: .06rem .2rem; border-radius: 3px; background: #fff2d6; color: #8b480e; }
  .desk-preview-recent .desk-preview-paid { background: #e5f5eb; color: #236748; }
  .desk-order-after, :global(.workflow:is([data-stage="2"],[data-stage="3"])) .desk-order-before { display: none; }
  :global(.workflow:is([data-stage="2"],[data-stage="3"])) .desk-order-after { display: inline; color: #0756cf; }
  @keyframes preview-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @container commerce-preview (max-width: 420px) {
    .desk-preview-sellers li { grid-template-columns: auto minmax(0,1fr); }
    .desk-preview-sellers small, .desk-preview-dates { display: none; }
  }
  @container commerce-preview (max-width: 355px) {
    .desk-preview-brand { font-size: .66rem; }
    .desk-preview-link { gap: .24rem; padding-inline: .19rem; font-size: .62rem; }
    .desk-preview-link svg { width: .66rem; height: .66rem; }
    .desk-preview-metrics dt { gap: .14rem; font-size: .91em; }
    .desk-preview-metrics dd { font-size: clamp(.62rem,3.3cqw,.82rem); }
    .desk-preview-reports > section { padding-inline: .24rem; }
    .desk-preview-recent > div { gap: .18rem; }
  }
  @container commerce-preview (max-width: 275px) {
    .desk-preview-metrics, .desk-preview-recent > div { grid-template-columns: repeat(2,minmax(0,1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .desk-preview-line { animation: none; } }
</style>
