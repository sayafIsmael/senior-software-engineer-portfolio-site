---
const providers = [
  { name: 'ChatGPT', icon: 'chatgpt' },
  { name: 'Gemini', icon: 'gemini' },
  { name: 'Claude', icon: 'claude' },
  { name: 'DeepSeek', icon: 'deepseek' },
];

---
<section id="ai-systems" class="section-rule" aria-labelledby="ai-systems-title">
  <header>
    <h2 id="ai-systems-title">AI for the way your business works</h2>
    <p>I build AI into everyday workflows. <a href="/work/automation-system/">BajuTech Inbox</a> answers product questions, checks stock, and takes orders in the same conversation.</p>
  </header>

  <ul class="providers" aria-label="AI providers in BajuTech Inbox">
    {providers.map(({ name, icon }) => (
      <li>
        <img src={`/images/ai-models/${icon}.svg`} width="34" height="34" alt="" loading="lazy" />
        <span>{name}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  section { display: grid; gap: clamp(1.2rem, 3vw, 2rem); padding-block: clamp(1.5rem, 4vw, 3rem); }
  h2 { margin: 0; font-size: clamp(1.45rem, 2.6vw, 2rem); line-height: 1.15; }
  p { margin: .5rem 0 0; max-width: 63ch; color: var(--muted); line-height: 1.5; }
  a { color: var(--green); font-weight: 650; }
  ul { margin: 0; padding: 0; list-style: none; }
  .providers { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .7rem; }
  li { display: grid; justify-items: center; align-content: center; gap: .4rem; min-height: 5.65rem; padding: .55rem .65rem; border: 1px solid var(--border); border-radius: 7px; background: var(--surface); font-size: .88rem; font-weight: 650; text-align: center; }
  img { box-sizing: content-box; object-fit: contain; background: white; padding: 4px; border-radius: 7px; }
  @media (max-width: 36rem) { .providers { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
