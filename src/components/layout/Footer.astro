---
import { site } from '../../data/site';
import SocialLink from '../ui/SocialLink.astro';
import Icon from '../ui/Icon.astro';
import CalendlyBooking from '../ui/CalendlyBooking.astro';
---
<footer id="contact" class="footer container section-rule">
  <div class="footer-top">
    <div>
      <p class="eyebrow"><span class="eyebrow-mark"></span> Let's talk</p>
      <h2>Have a difficult system to build?</h2>
      <p>Available for high-impact software architecture, secure engineering, and production-focused work.</p>
      <a class="text-link footer-phone" href={site.phone.href} aria-label={`Call ${site.name} at ${site.phone.label}`}>
        <Icon name="phone" size={16} /> {site.phone.label}
      </a>
    </div>

    <div class="footer-actions">
      <CalendlyBooking variant="compact" />
      <a href="/#work" class="back-to-work">Explore my work <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <CalendlyBooking variant="panel" class="footer-booking" />

  <div class="social-list" aria-label="Professional profiles">
    <SocialLink label="Email" icon="mail" href={site.links.email}/>
    <SocialLink label="GitHub" icon="github" href={site.links.github}/>
    <SocialLink label="LinkedIn" icon="linkedin" href={site.links.linkedin}/>
    <SocialLink label="Upwork" icon="award" href={site.links.upwork}/>
    <SocialLink label="YouTube" icon="youtube" href={site.links.youtube}/>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Abu Sayaf</span><span>Designed with intention. Built to be fast.</span><a href="#top">Back to top ↑</a></div>
</footer>
