---
import Icon from './Icon.astro';
import { site } from '../../data/site';

interface Props {
  variant?: 'panel' | 'compact' | 'inline';
  class?: string;
}

const { variant = 'panel', class: className = '' } = Astro.props;
const url: string = site.links.calendly;
const hasUrl = url.startsWith('https://');

// Accurate month calendar calculation
const now = new Date();
const currentYear = now.getFullYear();
const currentMonthIndex = now.getMonth();
const fullMonthNames = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'
];
const weekdayShort = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];

// 1st day of month (0 = Sun, 1 = Mon, ..., 6 = Sat)
const firstDayOfWeek = new Date(currentYear, currentMonthIndex, 1).getDay();
// Total days in month
const daysInMonth = new Date(currentYear, currentMonthIndex + 1, 0).getDate();
const todayDate = now.getDate();

interface CalendarCell {
  blank: boolean;
  day?: number;
  isPast?: boolean;
  isToday?: boolean;
  isWeekend?: boolean;
  isAvailable?: boolean;
  dateLabel?: string;
}

const calendarCells: CalendarCell[] = [];

// Leading empty cells
for (let i = 0; i < firstDayOfWeek; i++) {
  calendarCells.push({ blank: true });
}

// Actual days of month
for (let day = 1; day <= daysInMonth; day++) {
  const d = new Date(currentYear, currentMonthIndex, day);
  const dow = d.getDay();
  const isWeekend = dow === 0 || dow === 6;
  const isPast = day < todayDate;
  const isToday = day === todayDate;
  const isAvailable = !isPast && !isWeekend;
  calendarCells.push({
    blank: false,
    day,
    isPast,
    isToday,
    isWeekend,
    isAvailable,
    dateLabel: `${fullMonthNames[currentMonthIndex]} ${day}, ${currentYear}`,
  });
}
---
{variant === 'inline' ? (
  <a class:list={['button', 'button--primary', 'booking-cta', className]} href={hasUrl ? url : '#book'} data-calendly-link={hasUrl ? true : undefined} target={hasUrl ? '_blank' : undefined} rel={hasUrl ? 'noopener noreferrer' : undefined}>
    <Icon name="calendar" size={17} /> {site.booking.label}
  </a>
) : variant === 'compact' ? (
  <div class:list={['booking-compact', className]}>
    <a class="button button--primary booking-cta" href={hasUrl ? url : '#book'} data-calendly-link={hasUrl ? true : undefined} target={hasUrl ? '_blank' : undefined} rel={hasUrl ? 'noopener noreferrer' : undefined}>
      <Icon name="calendar" size={17} /> {site.booking.label}
    </a>
  </div>
) : (
  <aside id="book" class:list={['booking-panel', className]} data-booking-panel>
    <div class="booking-copy">
      <div class="booking-badge">
        <span class="booking-status-indicator"></span>
        <span>Open for architecture & consulting</span>
      </div>
      <h3>Book a focused working session</h3>
      <p>{site.booking.blurb}</p>

      <ul class="booking-meta">
        <li><Icon name="calendar" size={16} /> <strong>{site.booking.duration}</strong> video call (Google Meet / Zoom)</li>
        <li><Icon name="check-circle" size={16} /> Architecture review, cloud delivery, or discovery</li>
        <li><Icon name="activity" size={16} /> Clear next steps & actionable roadmap</li>
        <li><Icon name="bolt" size={16} /> Live real-time availability via Calendly</li>
      </ul>

      <div class="booking-actions">
        <a class="button button--primary booking-cta" href={url} data-calendly-link target="_blank" rel="noopener noreferrer">
          <Icon name="calendar" size={17} /> {site.booking.label} <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
      <p class="booking-footnote"><Icon name="shield-check" size={14} /> Direct 1-on-1 with Abu Sayaf · Select date on calendar to open schedule</p>
    </div>

    <div class="booking-calendar-wrapper">
      <div class="month-calendar-card">
        <div class="month-cal-header">
          <div class="month-cal-title">
            <span class="month-cal-icon"><Icon name="calendar" size={16} /></span>
            <strong>{fullMonthNames[currentMonthIndex]} {currentYear}</strong>
          </div>
          <span class="month-cal-badge">
            <span class="month-cal-pulse"></span> Available
          </span>
        </div>

        <!-- Weekday Labels -->
        <div class="month-cal-weekdays">
          {weekdayShort.map((w) => (
            <span class="month-cal-weekday">{w}</span>
          ))}
        </div>

        <!-- Month Calendar Grid -->
        <div class="month-cal-grid" role="grid" aria-label={`${fullMonthNames[currentMonthIndex]} ${currentYear} calendar`}>
          {calendarCells.map((cell) =>
            cell.blank ? (
              <span class="month-cal-day is-blank" aria-hidden="true" />
            ) : cell.isAvailable ? (
              <a
                href={url}
                data-calendly-link
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'month-cal-day',
                  'is-available',
                  { 'is-today': cell.isToday },
                ]}
                title={`Book on Calendly for ${cell.dateLabel}`}
              >
                <span class="cal-day-number">{cell.day}</span>
                <span class="cal-avail-dot" aria-hidden="true" />
              </a>
            ) : (
              <span
                class:list={[
                  'month-cal-day',
                  { 'is-past': cell.isPast },
                  { 'is-weekend': cell.isWeekend },
                  { 'is-today': cell.isToday },
                ]}
              >
                <span class="cal-day-number">{cell.day}</span>
              </span>
            )
          )}
        </div>

        <!-- Calendar Card Direct Action -->
        <div class="month-cal-footer">
          <div class="month-cal-legend">
            <span class="legend-item"><span class="legend-dot is-avail"></span> Available</span>
            <span class="legend-item"><span class="legend-dot is-today"></span> Today</span>
          </div>
          <a class="button button--primary month-cal-book-btn" href={url} data-calendly-link target="_blank" rel="noopener noreferrer">
            <Icon name="calendar" size={15} />
            <span>Select Time on Calendly</span>
            <Icon name="arrow-up-right" size={14} />
          </a>
        </div>
      </div>
    </div>
  </aside>
)}
