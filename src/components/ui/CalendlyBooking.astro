---
import Icon from './Icon.astro';
import { site } from '../../data/site';

interface Props {
  variant?: 'panel' | 'compact' | 'inline';
  class?: string;
}

const { variant = 'panel', class: className = '' } = Astro.props;
const url: string = site.links.calendly;
const hasUrl = url.startsWith('https://');

// Accurate build-time month calculation (hydrated & kept 100% dynamic on client)
const now = new Date();
const currentYear = now.getFullYear();
const currentMonthIndex = now.getMonth();
const fullMonthNames = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'
];
const weekdayShort = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];

// 1st day of month (0 = Sun, 1 = Mon, ..., 6 = Sat)
const firstDayOfWeek = new Date(currentYear, currentMonthIndex, 1).getDay();
const daysInMonth = new Date(currentYear, currentMonthIndex + 1, 0).getDate();
const todayDate = now.getDate();

interface CalendarCell {
  blank: boolean;
  day?: number;
  isPast?: boolean;
  isToday?: boolean;
  isAvailable?: boolean;
  dateLabel?: string;
}

const calendarCells: CalendarCell[] = [];

for (let i = 0; i < firstDayOfWeek; i++) {
  calendarCells.push({ blank: true });
}

for (let day = 1; day <= daysInMonth; day++) {
  const isPast = day < todayDate;
  const isToday = day === todayDate;
  calendarCells.push({
    blank: false,
    day,
    isPast,
    isToday,
    isAvailable: !isPast,
    dateLabel: `${fullMonthNames[currentMonthIndex]} ${day}, ${currentYear}`,
  });
}
---
{variant === 'inline' ? (
  <a class:list={['button', 'button--primary', 'booking-cta', className]} href={hasUrl ? url : '#book'} target={hasUrl ? '_blank' : undefined} rel={hasUrl ? 'noopener noreferrer' : undefined}>
    <Icon name="calendar" size={17} /> {site.booking.label}
  </a>
) : variant === 'compact' ? (
  <div class:list={['booking-compact', className]}>
    <a class="button button--primary booking-cta" href={hasUrl ? url : '#book'} target={hasUrl ? '_blank' : undefined} rel={hasUrl ? 'noopener noreferrer' : undefined}>
      <Icon name="calendar" size={17} /> {site.booking.label}
    </a>
  </div>
) : (
  <aside id="book" class:list={['booking-panel', className]} data-booking-panel>
    <div class="booking-copy">
      <div class="booking-badge">
        <span class="booking-status-indicator"></span>
        <span>Live Schedule · Instant Booking</span>
      </div>
      <h3>Book a 30-min working session</h3>
      <p>Architecture review, technical roadmap, or direct engineering consultation.</p>

      <div class="booking-chips">
        <span class="booking-chip"><Icon name="calendar" size={13} /> 30 min</span>
        <span class="booking-chip"><Icon name="check-circle" size={13} /> Video Call</span>
        <span class="booking-chip"><Icon name="bolt" size={13} /> Live availability</span>
      </div>

      <div class="booking-actions">
        <a class="button button--primary booking-cta" href={url} target="_blank" rel="noopener noreferrer">
          <Icon name="calendar" size={16} /> Open Calendly Schedule <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
      <p class="booking-footnote"><Icon name="shield-check" size={13} /> Click any date on the calendar to open real-time availability</p>
    </div>

    <div class="booking-calendar-wrapper">
      <div class="month-calendar-card" data-dynamic-calendar data-calendly-url={url}>
        <div class="month-cal-header">
          <a href={url} target="_blank" rel="noopener noreferrer" class="month-cal-title" title="Open schedule on Calendly">
            <span class="month-cal-icon"><Icon name="calendar" size={14} /></span>
            <strong data-cal-month-label>{fullMonthNames[currentMonthIndex]} {currentYear}</strong>
          </a>
          <a href={url} target="_blank" rel="noopener noreferrer" class="month-cal-badge" title="View live availability on Calendly">
            <span class="month-cal-pulse"></span>
            <span>Live Availability</span>
            <Icon name="arrow-up-right" size={11} />
          </a>
        </div>

        <!-- Weekday Labels -->
        <div class="month-cal-weekdays">
          {weekdayShort.map((w) => (
            <span class="month-cal-weekday">{w}</span>
          ))}
        </div>

        <!-- Month Calendar Grid (dynamically updated on client) -->
        <div class="month-cal-grid" data-cal-grid role="grid" aria-label="Monthly calendar preview">
          {calendarCells.map((cell) =>
            cell.blank ? (
              <span class="month-cal-day is-blank" aria-hidden="true" />
            ) : cell.isAvailable ? (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'month-cal-day',
                  'is-active-day',
                  { 'is-today': cell.isToday },
                ]}
                title={`View available times for ${cell.dateLabel} on Calendly`}
              >
                <span class="cal-day-number">{cell.day}</span>
              </a>
            ) : (
              <span
                class:list={[
                  'month-cal-day',
                  'is-past',
                  { 'is-today': cell.isToday },
                ]}
                title={`${cell.dateLabel} (Past)`}
              >
                <span class="cal-day-number">{cell.day}</span>
              </span>
            )
          )}
        </div>

        <!-- Calendar Card Direct Action -->
        <div class="month-cal-footer">
          <div class="month-cal-legend">
            <span class="legend-item"><span class="legend-dot is-today"></span> Today</span>
            <span class="legend-item"><span class="legend-dot is-avail"></span> Bookable on Calendly</span>
          </div>
          <a class="month-cal-direct-link" href={url} target="_blank" rel="noopener noreferrer">
            <span>View Times ↗</span>
          </a>
        </div>
      </div>
    </div>
  </aside>
)}
